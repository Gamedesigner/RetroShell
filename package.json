{
  "name": "retro-shell",
  "version": "1.0.0",
  "description": "A retro-styled PowerShell terminal",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc",
    "build:renderer": "esbuild src/renderer/terminal.ts --bundle --outfile=dist/renderer/terminal.js --platform=browser --format=iife --sourcemap",
    "build:assets": "copyfiles -u 2 src/renderer/**/*.html src/renderer/**/*.css dist/renderer",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "watch": "tsc -w",
    "start": "npm run build && electron .",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
